diff -Nru a/src/ffmpeg9compat.h b/src/ffmpeg9compat.h
--- a/src/ffmpeg9compat.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/ffmpeg9compat.h	2026-08-14 19:06:29.691438916 +0200
@@ -0,0 +1,124 @@
+/* FFmpeg 5-9 compatibility for abandoned ffmpeg2theora 0.30 */
+#ifndef FF2THEORA_FFMPEG9_H
+#define FF2THEORA_FFMPEG9_H
+
+#include <string.h>
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/imgutils.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/frame.h>
+#include <libavutil/mem.h>
+#include <libavutil/pixdesc.h>
+#include <libavutil/pixfmt.h>
+
+#ifndef AVPicture
+typedef struct AVFrame AVPicture;
+#endif
+
+static inline int ff2t_picture_get_size(int pix_fmt, int w, int h)
+{
+	return av_image_get_buffer_size((enum AVPixelFormat)pix_fmt, w, h, 1);
+}
+
+static inline int ff2t_picture_fill(AVFrame *pic, uint8_t *ptr, int pix_fmt, int w, int h)
+{
+	return av_image_fill_arrays(pic->data, pic->linesize, ptr,
+				    (enum AVPixelFormat)pix_fmt, w, h, 1);
+}
+
+static inline void ff2t_picture_free(AVFrame *pic)
+{
+	av_freep(&pic->data[0]);
+}
+
+static inline void ff2t_picture_copy(AVFrame *dst, const AVFrame *src, int pix_fmt, int w, int h)
+{
+	av_image_copy(dst->data, dst->linesize,
+		      (const uint8_t * const *)src->data, src->linesize,
+		      (enum AVPixelFormat)pix_fmt, w, h);
+}
+
+static inline int ff2t_picture_crop(AVFrame *dst, const AVFrame *src,
+				    int pix_fmt, int top, int left)
+{
+	const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get((enum AVPixelFormat)pix_fmt);
+	int i;
+	if (!desc)
+		return -1;
+	for (i = 0; i < 4; i++) {
+		int hshift = (i == 1 || i == 2) ? desc->log2_chroma_w : 0;
+		int vshift = (i == 1 || i == 2) ? desc->log2_chroma_h : 0;
+		if (!src->data[i]) {
+			dst->data[i] = NULL;
+			dst->linesize[i] = 0;
+			continue;
+		}
+		dst->data[i] = src->data[i]
+			+ (src->linesize[i] * (top >> vshift))
+			+ ((left >> hshift) * ((desc->comp[i].depth + 7) / 8));
+		dst->linesize[i] = src->linesize[i];
+	}
+	return 0;
+}
+
+static inline int ff2t_picture_pad(AVFrame *dst, const AVFrame *src,
+				   int height, int width, int pix_fmt,
+				   int padtop, int padbottom, int padleft, int padright,
+				   int *color)
+{
+	(void)padbottom;
+	(void)padright;
+	(void)color;
+	int size = av_image_get_buffer_size((enum AVPixelFormat)pix_fmt, width, height, 1);
+	if (size < 0)
+		return size;
+	if (dst->data[0])
+		memset(dst->data[0], 0, size);
+	av_image_copy(dst->data, dst->linesize,
+		      (const uint8_t * const *)src->data, src->linesize,
+		      (enum AVPixelFormat)pix_fmt,
+		      width - padleft, height - padtop);
+	return 0;
+}
+
+static inline int ff2t_decode_video(AVCodecContext *avctx, AVFrame *frame,
+				    int *got_frame, AVPacket *pkt)
+{
+	int ret;
+	*got_frame = 0;
+	ret = avcodec_send_packet(avctx, pkt);
+	if (ret < 0 && ret != AVERROR(EAGAIN) && ret != AVERROR_EOF)
+		return ret;
+	ret = avcodec_receive_frame(avctx, frame);
+	if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF)
+		return 0;
+	if (ret < 0)
+		return ret;
+	*got_frame = 1;
+	return pkt ? pkt->size : 0;
+}
+
+static inline int ff2t_decode_audio(AVCodecContext *avctx, AVFrame *frame,
+				    int *got_frame, AVPacket *pkt)
+{
+	return ff2t_decode_video(avctx, frame, got_frame, pkt);
+}
+
+static inline AVCodecContext *ff2t_alloc_ctx(AVStream *st)
+{
+	const AVCodec *codec = avcodec_find_decoder(st->codecpar->codec_id);
+	AVCodecContext *ctx = avcodec_alloc_context3(codec);
+	if (!ctx)
+		return NULL;
+	if (avcodec_parameters_to_context(ctx, st->codecpar) < 0) {
+		avcodec_free_context(&ctx);
+		return NULL;
+	}
+	return ctx;
+}
+
+#define av_register_all() do { } while (0)
+#define avcodec_register_all() do { } while (0)
+
+#endif
